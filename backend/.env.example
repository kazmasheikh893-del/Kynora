# Kynora Backend Configuration

# Server & CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (MySQL)
# Format: mysql+mysqlconnector://<username>:<password>@<host>:<port>/<database>
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=kynora_db

# Machine Learning Engine
# Default trained model artifact path
ML_MODEL_PATH=app/ml/artifacts/best_priority_model.joblib
ML_VECTORIZER_PATH=app/ml/artifacts/tfidf_vectorizer.joblib

# Google OAuth 2.0 & Gmail API (Read-only scope: https://www.googleapis.com/auth/gmail.readonly)
# Automatically loaded from backend/secrets/google_oauth_client.json if present
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Secret key for encrypting stored OAuth refresh tokens in MySQL
TOKEN_ENCRYPTION_KEY=replace_with_a_unique_random_secret

# Optional LLM fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
